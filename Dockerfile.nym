FROM rust:1.90-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends git pkg-config libssl-dev cmake protobuf-compiler && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/nymtech/nym-rpc.git /src && cd /src && git checkout 3531ba49427ec6d405c5e129eb8064506ced540b
WORKDIR /src
RUN cargo build --release --locked
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/nym-rpc-server /usr/local/bin/
COPY --from=build /src/target/release/nym-rpc-client /usr/local/bin/
